      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Chọn một bản bắt PCAP hoặc PCAPNG, bản bắt nén gzip hoặc một phiên TCP Viewer. Tracexy đọc nội dung tệp, không dựa vào tên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 PCAP 或 PCAPNG 抓包文件、gzip 压缩的抓包文件或 TCP Viewer 会话。Tracexy 会读取文件内容而非依赖文件名。"
          }
        }
      }
    },
    "Choose a Project to view its saved workspaces.": {
